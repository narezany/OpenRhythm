 "hints": [
  {
   "t": 1.0,
   "text": "Welcome to the tutorial! Let's learn how to play."
  },
  {
   "t": 5.0,
   "text": "Watch the frame: a cube will fly into one of the nine cells."
  },
  {
   "t": 8.8,
   "text": "Move your cursor onto that cell and CATCH the cube when it lands!"
  },
  {
   "t": 15.0,
   "text": "Dead center = PERFECT. A bit off = GREAT or GOOD. Edge = BULLSHIT."
  },
  {
   "t": 22.5,
   "text": "Missed? No worries — try again, nobody's watching."
  },
  {
   "t": 30.9,
   "text": "Long cubes are HOLDS: stay on them until they run out."
  },
  {
   "t": 37.5,
   "text": "Let go early and the hold does not count. Carry it to the end."
  },
  {
   "t": 43.4,
   "text": "A cube in a ring has to be CLICKED, not just covered."
  },
  {
   "t": 50.0,
   "text": "In other songs clicks are off until you switch on the CLICKS modifier."
  },
  {
   "t": 53.6,
   "text": "All three together now — good luck!"
  }
 ],
