# Godot
.godot/
*.translation

# Build output
build/
*.apk
*.aab
*.idsig
*.exe
*.pck
*.x86_64
*.dmg
*.app/

# Android signing — never commit these
*.keystore
*.jks
release.properties
android/

# Local editor / OS junk
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Third-party music. These hold copyrighted audio and video and are NOT part of
# the open-source release - they live outside the game as installable song zips
# instead of being built into it. Only the OST tracks generated by
# tools/gen_media.py and tools/gen_pack2.py ship with the repository.
local_songs/
dist/

# Godot imports every image it finds; the README art is not game content
docs/img/*.import

# Python bytecode from the chart tools
__pycache__/

# OpenXR loaders for the headset builds: 80 MB of vendor binaries under their
# own licences. CI fetches them at the version pinned in the workflow; locally,
# unzip godotopenxrvendorsaddon.zip from the godot_openxr_vendors release into
# addons/.
addons/godotopenxrvendors/
