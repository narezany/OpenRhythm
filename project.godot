; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Open Rhythm"
config/description="Rhythm game collection. Open maps, any audio."
run/main_scene="res://scenes/Boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
# The Android back button is handled by Main, which turns it into Esc rather
# than letting the system close the game.
config/quit_on_go_back=false

[autoload]

G="*res://scripts/G.gd"
Loc="*res://scripts/Loc.gd"
Conductor="*res://scripts/Conductor.gd"
Net="*res://scripts/core/Net.gd"
UICursor="*res://scripts/UICursor.gd"

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
; "expand" keeps the design scale and reveals extra canvas on the long axis.
; "fill" would squash the picture on anything that is not 16:9 - phones are
; 19.5:9 or 20:9, so that was visible on almost every device.
window/stretch/aspect="expand"
window/handheld/orientation=0

[debug]

# The engine's own log, kept on disk. When a headset shows nothing there is no
# console to read, and the reason OpenXR refused is written by the engine, not
# by the game - this is the only way to get at it without a working cable.
file_logging/enable_file_logging=true

[xr]

# On everywhere the engine has it. The desktop build then finds a runtime when
# SteamVR is up and starts in VR, and finds nothing when it is not and starts
# in a window - one build, no switch to flip. The phone package is exported
# with XR mode off, so it has no OpenXR to try in the first place.
openxr/enabled=true
# No alert box when there is no headset: most players are on a flat screen and
# a runtime that is simply not running is not an error worth interrupting them
# with. Boot falls back to a window on its own.
openxr/startup_alert=false
shaders/enabled=true

[rendering]

renderer/rendering_method="gl_compatibility"
# Headsets get Vulkan. OpenXR on Android binds to the graphics API when it
# creates its session, and the OpenGL ES binding is not the one that works
# there: the interface is found, the session never is, and the headset sits on
# its loading screen while the game runs behind it.
#
# These two come BEFORE the .mobile line, and the order is the whole point.
# The FIRST matching feature wins - measured, not assumed - and a headset
# package matches "mobile" as well as its own tag, so listing them the other
# way round quietly leaves it on Compatibility.
renderer/rendering_method.quest="mobile"
renderer/rendering_method.pico="mobile"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
viewport/transparent_background=false
